{
  "name": "psmatmodranization",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "allure:deletereports": "rimraf allure-report allure-results",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",

    "clean": "rimraf atest-results playwight-report",
    "test": "npm run clean && playwright test",

    "trace": "npx playwright show-trace",
    "showreport": "npx playwright show-report --port 9333",

    "debug": "npx playwright test --debug",

    "OrangeHRMTest": "npx playwright test --grep @OrangeHRMTest",
    "SearchOrangemodulesTest": "npx playwright test --grep @SearchModulesTest",
    "all": "npm run OrangeHRMTest && npm run SearchOrangemodulesTest",

    "all:singleworker": "npx playwright test tests/OrangeHRM.spec.ts --workers=1",

    "dev:chrome": "npx playwright test tests/OrangeHRM.spec.ts --config=playwright.config.dev.ts --project=\"Google Chrome\"",
    "dev:edge": "npx playwright test tests/OrangeHRM.spec.ts --config=playwright.config.dev.ts --project=\"Microsoft Edge\"",
    "dev:firefox": "npx playwright test tests/OrangeHRM.spec.ts --config=playwright.config.dev.ts --project=\"Firefox\"",
    "dev:webkit": "npx playwright test tests/OrangeHRM.spec.ts --config=playwright.config.dev.ts --project=\"Webkit\"",

    "acpt:chrome": "npx playwright test --config=playwright.config.acpt.ts --project=\"Google Chrome\"",
    "acpt:edge": "npx playwright test --config=playwright.config.acpt.ts --project=\"Microsoft Edge\"",
    "acpt:firefox": "npx playwright test --config=playwright.config.acpt.ts --project=\"Firefox\"",
    "acpt:webkit": "npx playwright test --config=playwright.config.acpt.ts --project=\"Webkit\"",

    "acpt:OrangeHRMTestTest:chrome": "npx playwright test --config=playwright.config.acpt.ts --project=\"Google Chrome\" --grep @OrangeHRMTest",
    "acpt:OrangeHRMTestTest:edge": "npx playwright test --config=playwright.config.acpt.ts --project=\"Microsoft Edge\" --grep @OrangeHRMTest",
    "acpt:OrangeHRMTestTest:firefox": "npx playwright test --config=playwright.config.acpt.ts --project=\"Firefox\" --grep @OrangeHRMTest",
    "acpt:OrangeHRMTestTest:webkit": "npx playwright test --config=playwright.config.acpt.ts --project=\"Webkit\" --grep @OrangeHRMTest",

    "act:OrangeHRMTest:all": "npm run acpt:OrangeHRMTest:chrome && npm run acpt:OrangeHRMTest:edge && npm run acpt:OrangeHRMTest:firefox",

    "acpt:SearchInprogressTest:chrome": "npx playwright test --config=playwright.config.acpt.ts --project=\"Google Chrome\" --grep @SearchModulesTest",
    "acpt:SearchInprogressTest:edge": "npx playwright test --config=playwright.config.acpt.ts --project=\"Microsoft Edge\" --grep @SearchModulesTest",
    "acpt:SearchInprogressTest:firefox": "npx playwright test --config=playwright.config.acpt.ts --project=\"Firefox\" --grep @SearchModulesTest",
    "acpt:SearchInprogressTest:webkit": "npx playwright test --config=playwright.config.acpt.ts --project=\"Webkit\" --grep @SearchModulesTest",

    "act:SearchInprogressTest:all": "npm run acpt:SearchInprogressTest:chrome && npm run acpt:SearchInprogressTest:edge && npm run acpt:SearchInprogressTest:firefox",
    
    "smoke": "npx playwright test tests/OrangeHRM.spec.ts --grep @smokeTest",
    "regression": "npx playwright test tests/OrangeHRM.spec.ts --grep @regressionTest",
    "smoke:regression": "npm run smoke && npm run regression"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.6.0",
    "playwright-html-reporter": "^0.1.11",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
